<Node ToolID="10"><GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="534" y="80" /></GuiSettings><Properties><Configuration><FormulaFields><FormulaField expression="IIF(IsNull([monto]), 0, [monto])" field="monto" size="8" type="Double" /><FormulaField expression="IIF(IsNull([cantidad_pagos]), 0, [cantidad_pagos])" field="cantidad_pagos" size="4" type="Int32" /><FormulaField expression='ToNumber(DateTimeFormat([rental_date], "%Y%m%d"))' field="fecha_key" size="4" type="Int32" /><FormulaField expression="1" field="cantidad" size="1" type="Byte" /><FormulaField expression="IIF(IsNull([return_date]), 0, 1)" field="devuelto" size="1" type="Byte" /><FormulaField expression='IIF(IsNull([return_date]), Null(), DateTimeDiff([return_date], [rental_date], "seconds") / 86400)' field="dias_alquilado" size="8" type="Double" /><FormulaField expression='IIF(IsNull([return_date]), Null(), Max(0, DateTimeDiff([return_date], [rental_date], "seconds") / 86400 - [rental_duration]))' field="dias_atraso" size="8" type="Double" /><FormulaField expression='IIF(IsNull([return_date]) OR IsNull([rental_duration]) OR [rental_duration] &lt;= 0, Null(), IIF(DateTimeDiff([return_date], [rental_date], "seconds") &gt; [rental_duration] * 86400, 1, 0))' field="devolucion_tardia" size="1" type="Byte" /><FormulaField expression="IIF([monto] = 0, 1, 0)" field="pago_cero" size="1" type="Byte" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name>Medidas: fecha_key, días, atraso, banderas (C04, C06, C23)</Name><DefaultAnnotationText /><Left value="False" /></Annotation></Properties><EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" /></Node>
